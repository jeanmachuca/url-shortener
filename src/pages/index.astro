---
import ShortenForm from '../components/ShortenForm.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Free edge-fast URL shortener. Shorten, share, and count clicks at zero cost." />
    <title>Shortn — free URL shortener</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <h1>
        <span class="mark">/s/</span> Shortn
      </h1>
      <p class="tagline">Short links, edge-fast, at zero cost.</p>
      <ShortenForm />
    </main>
  </body>
</html>

<style>
  :root {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: radial-gradient(1200px 600px at 50% -10%, #0b2740 0%, #0b1220 55%);
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  main {
    width: min(92vw, 560px);
    padding: 2rem;
  }
  h1 {
    margin: 0 0 0.25rem;
    font-size: 2.4rem;
    letter-spacing: -0.02em;
  }
  .mark {
    color: #38bdf8;
  }
  .tagline {
    margin: 0 0 1.75rem;
    color: #94a3b8;
  }
  form {
    display: grid;
    gap: 0.75rem;
  }
  input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    background: #0f172a;
    color: #f1f5f9;
    font-size: 1rem;
  }
  input::placeholder {
    color: #64748b;
  }
  button[type='submit'] {
    padding: 0.8rem 1.1rem;
    border: 0;
    border-radius: 0.5rem;
    background: #0ea5e9;
    color: #062033;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  button[type='submit']:hover {
    background: #38bdf8;
  }
  @media (prefers-reduced-motion: no-preference) {
    button[type='submit'] {
      transition: background 0.15s ease;
    }
  }
</style>
